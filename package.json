{
  "name": "criterium",
  "version": "0.1.0",
  "description": "An ATS debugger for developers: compare your resume against a job description before applying.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "check": "tsc --noEmit"
  },
  "keywords": [
    "ats",
    "resume",
    "cv",
    "developer-tools",
    "job-search"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
