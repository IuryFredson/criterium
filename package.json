{
  "name": "criterium",
  "version": "0.1.0",
  "description": "An ATS debugger for developers: compare your resume against a job description before applying.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:cli": "tsx src/cli.ts"
  },
  "keywords": [
    "ats",
    "resume",
    "cv",
    "developer-tools",
    "job-search"
  ],
  "license": "MIT",
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "bin": {
    "criterium": "dist/cli.js"
  }
}
